{
  "manifest_version": 3,
  "name": "OfferClaw",
  "version": "0.1.0",
  "description": "AI 岗位匹配助手：在 BOSS直聘 / 实习僧 / 51job / 智联 / 牛客 / LinkedIn 等招聘站浏览岗位时，用你自己的 LLM Key 打匹配分、生成打招呼语、管理投递看板",
  "homepage_url": "https://github.com/love-xuexi/offerclaw",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OfferClaw",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "host_permissions": [
    "*://*.zhipin.com/*",
    "*://*.shixiseng.com/*",
    "*://*.51job.com/*",
    "*://*.zhaopin.com/*",
    "*://*.nowcoder.com/*",
    "*://*.yingjiesheng.com/*",
    "*://*.linkedin.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.zhiye.com/*",
    "*://*.mokahr.com/*",
    "*://*.jobs.feishu.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.zhipin.com/*",
        "*://*.shixiseng.com/*",
        "*://*.51job.com/*",
        "*://*.zhaopin.com/*",
        "*://*.nowcoder.com/*",
        "*://*.yingjiesheng.com/*",
        "*://*.linkedin.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.zhiye.com/*",
        "*://*.mokahr.com/*",
        "*://*.jobs.feishu.cn/*"
      ],
      "js": [
        "src/common/messages.js",
        "src/common/util.js",
        "src/content/extractors.js",
        "src/content/panel.js",
        "src/content/content.js"
      ],
      "css": ["src/content/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
